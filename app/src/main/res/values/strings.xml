    <string name="about_title">About SayPiper</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_offline">SayPiper works without the internet. It has no accounts, adverts or purchases, and your progress stays on this device.</string>
    <string name="about_privacy">Privacy: nicknames, avatars, classes, settings, lesson results and word progress are stored only on this device. Nothing leaves the device. Nothing is backed up or transferred to another device. Deleting a profile removes its progress; uninstalling the app removes all stored data.</string>
    <string name="about_accessibility">P1 and P2 cannot be played without sight in this version.</string>
