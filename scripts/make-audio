#!/usr/bin/env bash
# Generate committed Cori clips, never during an Android build. Linux x86_64, no root.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
CACHE="${AUDIO_CACHE_DIR:-$HOME/.cache/wordquest-audio}"
command -v uv >/dev/null || { echo 'Install uv without root: https://docs.astral.sh/uv/getting-started/installation/' >&2; exit 1; }
AUDIO_UV_VERSION="$(uv --version)"
if [[ "$AUDIO_UV_VERSION" != "uv 0.13.7" && "$AUDIO_UV_VERSION" != "uv 0.13.7 "* ]]; then
    echo 'This pipeline requires uv 0.13.7; install that version without root.' >&2
    exit 1
fi
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export UV_CACHE_DIR="$CACHE/uv-cache" UV_PYTHON_INSTALL_DIR="$CACHE/python"
export PYTHONDONTWRITEBYTECODE=1
mkdir -p "$CACHE"
if [[ ! -x "$CACHE/venv/bin/python" ]]; then
    uv venv --python 3.10.22 "$CACHE/venv"
fi
uv pip sync --python "$CACHE/venv/bin/python" --require-hashes "$SCRIPT_DIR/audio/requirements.lock"
exec "$CACHE/venv/bin/python" "$SCRIPT_DIR/audio/generate.py" --cache "$CACHE" "$@"
